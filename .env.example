# ValiCrypt Environment Configuration

# Application
PROJECT_NAME="ValiCrypt"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Upload & Payload Safety Thresholds (Bytes)
MAX_UPLOAD_SIZE=104857600        # 100 MB max carrier file
MAX_PAYLOAD_SIZE=52428800        # 50 MB max payload size
MAX_ZIP_EXTRACTED_SIZE=104857600 # 100 MB max uncompressed zip (decompression bomb protection)

# Cryptographic Argon2id Parameters (RFC 9106)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536         # 64 MiB in KiB
ARGON2_PARALLELISM=4

# Tool Binaries & Work Directories
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
TEMP_DIRECTORY="/tmp/valicrypt"

# Persistence
DATABASE_URL="sqlite:///./mediavault.db"
